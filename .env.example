# Copia este archivo como .env y complétalo:  cp .env.example .env

# Dirección con la que se entra al sistema. Debe apuntar (registro A) a la IP del servidor.
# Para probar en tu propio equipo usa: localhost
DOMINIO=sgi.tuempresa.com

# Correo para los avisos de vencimiento del certificado HTTPS
CORREO_ADMIN=correo@tuempresa.com

# Clave temporal del usuario "admin" en el primer arranque. Si la dejas vacía se genera una al azar
# y aparece en el log (docker compose logs sgi). Se pide cambiarla al entrar.
ADMIN_CLAVE_INICIAL=

# Opcionales
TZ=America/Bogota
SESSION_HORAS=12
BACKUP_HORA=2
BACKUP_KEEP=30
