# OIKOS en Apache (XAMPP): todo se sirve desde public/. Las pantallas son archivos estáticos y /api la atiende PHP
# (public/api/index.php), que guarda en MySQL. En cPanel, la raíz del subdominio apunta directo a public/ y este archivo no se usa.
Options -Indexes
RewriteEngine On
RewriteCond %{REQUEST_URI} !/public/
RewriteRule ^(.*)$ public/$1 [L]
