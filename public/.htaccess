# OIKOS en Apache (XAMPP o cPanel): esta carpeta es la raíz pública. Las pantallas son archivos estáticos;
# todo lo que empieza por /api (y /healthz) lo atiende api/index.php.
Options -Indexes
DirectoryIndex index.html

RewriteEngine On
RewriteCond %{REQUEST_URI} !/api/index\.php$
RewriteRule ^(api/.*|healthz)$ api/index.php [L,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; form-action 'self'; base-uri 'self'"
</IfModule>
